{
  "mcpServers": {
    "higgsfield-official": {
      "type": "http",
      "url": "https://mcp.higgsfield.ai/mcp"
    },
    "frameforge-higgsfield": {
      "type": "stdio",
      "command": "node",
      "args": [
        "--env-file=.env",
        "scripts/higgsfield-mcp.mjs"
      ]
    },
    "frameforge-studio": {
      "type": "stdio",
      "command": "node",
      "args": [
        "--env-file=.env",
        "scripts/frameforge-mcp.mjs"
      ]
    }
  }
}
