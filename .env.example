HOST=127.0.0.1
PORT=4310
DATA_DIR=./data
# Set the full HTTPS origin when serving through Tailscale or another TLS proxy.
PUBLIC_ORIGIN=
# Generate a private token with scripts/configure.mjs before deployment.
LOGIN_TOKEN=
AGENT_BRIDGE_URL=http://127.0.0.1:4311
AGENT_BRIDGE_TOKEN=
# Optional Higgsfield Developer API credential KEY_ID:KEY_SECRET; distinct from CLI/MCP OAuth.
# Empty uses the authenticated Windows host's existing official Higgsfield CLI login.
HF_API_KEY=
# Optional Commons discovery/import; identify the application and operator contact.
MEDIA_USER_AGENT=
# Optional channel-bound YouTube Data API OAuth; never commit real credentials.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Empty derives /oauth/youtube/callback from PUBLIC_ORIGIN.
YOUTUBE_REDIRECT_URI=
# Set true only when the configured Google OAuth app is in Testing status.
YOUTUBE_OAUTH_TESTING=false
# Naver DataLab compares configured keyword groups; it is not a live ranking API.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Agent API / MCP (docs/agent-api.md, docs/mcp.md). The stdio MCP proxy reads these.
FRAMEFORGE_URL=http://127.0.0.1:4310
# Same value as LOGIN_TOKEN; sent as a bearer token to /api/agent/* and /mcp only.
FRAMEFORGE_TOKEN=
# Leave false: agents may not start paid Higgsfield generation unless the operator opts in.
AGENT_API_ALLOW_PAID_GENERATION=false
