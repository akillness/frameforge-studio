HOST=127.0.0.1
PORT=4310
DATA_DIR=./data
# Set the full HTTPS origin when serving through Tailscale or another TLS proxy.
PUBLIC_ORIGIN=
# Generate a private token with scripts/configure.mjs before deployment.
LOGIN_TOKEN=
AGENT_BRIDGE_URL=http://127.0.0.1:4311
AGENT_BRIDGE_TOKEN=
# Optional Higgsfield Developer API credential KEY_ID:KEY_SECRET; distinct from CLI/MCP OAuth.
# Empty uses the authenticated Windows host's existing official Higgsfield CLI login.
HF_API_KEY=
# Naver DataLab compares configured keyword groups; it is not a live ranking API.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
